<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Deliberately WITHOUT disable-library-validation: the hardened runtime
  keeps Library Validation ON.
  The release pipeline (jorvik-release/helpers/sign-framework.sh) re-signs the
  embedded Sparkle.framework and every nested XPC service / helper with the
  Jorvik Developer ID, leaf-first, so all loaded code shares the app's Team ID
  and passes Library Validation on its own.
  `com.apple.security.cs.disable-library-validation` was dropped 2026-08-25
  (open-follow-ups §15). Citadel is the canary; QuitProtect and Lookout are the
  accepted followers.
  Pre-release check, which an ad-hoc local build cannot prove: on a signed and
  notarised build, launch it and confirm a Sparkle update check runs without a
  library-validation kill.
-->
<plist version="1.0">
<dict>
    <!-- The app captures the camera directly now. Previously this lived on
         ASCIISaverCameraAgent, because a .saver inside legacyScreenSaver
         could not hold the grant itself.

         The application-groups entitlement that used to sit alongside it is
         deliberately gone: it existed only so the agent and the saver could
         share a frame buffer, and there is no second process any more. -->
    <key>com.apple.security.device.camera</key>
    <true/>
</dict>
</plist>
